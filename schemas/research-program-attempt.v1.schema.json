{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/research-program-attempt.v1.schema.json",
  "title": "Forge Bio Research Program Attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt_id",
    "schema_version",
    "benchmark_family",
    "benchmark_generation",
    "endpoint",
    "horizon",
    "primary_metric",
    "model_family",
    "result_status",
    "visibility",
    "relationship_to_prior_attempts",
    "digest",
    "attempt_tier",
    "registered_at",
    "map_digest",
    "disclosure_status",
    "disclosure_due_at",
    "research_program_id",
    "result_recorded_at"
  ],
  "properties": {
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "research-program-attempt-v1"
    },
    "benchmark_family": {
      "const": "B-TGT-E1"
    },
    "benchmark_generation": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "enum": [
        "E1-NOVEL-STRICT",
        "E1-MATURATION",
        "E1-REPLICATION",
        "E1-CROSSMODAL"
      ]
    },
    "horizon": {
      "enum": [
        "3y",
        "5y",
        "7y",
        "10y"
      ]
    },
    "primary_metric": {
      "enum": [
        "EVENT_RANK_PERCENTILE_V1",
        "RECALL_AT_1_PERCENT",
        "NDCG_PREREGISTERED"
      ]
    },
    "model_family": {
      "type": "string",
      "minLength": 1
    },
    "result_status": {
      "enum": [
        "POSITIVE",
        "NULL",
        "NEGATIVE",
        "INCONCLUSIVE",
        "FAILED_EXECUTION"
      ]
    },
    "visibility": {
      "enum": [
        "INTERNAL",
        "PUBLIC"
      ]
    },
    "relationship_to_prior_attempts": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "attempt_tier": {
      "enum": [
        "DEVELOPMENT",
        "CONFIRMATORY",
        "PROSPECTIVE"
      ]
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "map_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "external_seal_attestation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "disclosure_status": {
      "enum": [
        "SCHEDULED",
        "PUBLIC"
      ]
    },
    "disclosure_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "research_program_id": {
      "const": "FORGE-BIO-B-TGT-E1-V0"
    },
    "result_recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmatory_program_budget_id": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "CPB-FORGE-BIO-B-TGT-E1-V0",
        null
      ]
    },
    "allocation_generation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "allocated_alpha": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "maximum": 0.05
    },
    "attempt_index": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "attempt_tier": {
            "enum": [
              "CONFIRMATORY",
              "PROSPECTIVE"
            ]
          }
        },
        "required": [
          "attempt_tier"
        ]
      },
      "then": {
        "required": [
          "external_seal_attestation_id",
          "confirmatory_program_budget_id",
          "allocation_generation_id",
          "allocated_alpha",
          "attempt_index"
        ],
        "properties": {
          "external_seal_attestation_id": {
            "type": "string",
            "minLength": 1
          },
          "confirmatory_program_budget_id": {
            "const": "CPB-FORGE-BIO-B-TGT-E1-V0"
          },
          "allocation_generation_id": {
            "type": "string",
            "minLength": 1
          },
          "allocated_alpha": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 0.05
          }
        }
      }
    }
  ]
}
