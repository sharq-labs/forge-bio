{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/research-program-attempt.v1.schema.json",
  "title": "Forge Bio Research Program Attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt_id",
    "schema_version",
    "benchmark_family",
    "benchmark_generation",
    "endpoint",
    "horizon",
    "primary_metric",
    "model_family",
    "result_status",
    "visibility",
    "relationship_to_prior_attempts",
    "digest",
    "attempt_tier",
    "registered_at",
    "map_digest",
    "disclosure_status",
    "disclosure_due_at"
  ],
  "properties": {
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "research-program-attempt-v1"
    },
    "benchmark_family": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_generation": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "string",
      "minLength": 1
    },
    "horizon": {
      "type": "string",
      "minLength": 1
    },
    "primary_metric": {
      "type": "string",
      "minLength": 1
    },
    "model_family": {
      "type": "string",
      "minLength": 1
    },
    "result_status": {
      "enum": [
        "POSITIVE",
        "NULL",
        "NEGATIVE",
        "INCONCLUSIVE",
        "FAILED_EXECUTION"
      ]
    },
    "visibility": {
      "enum": [
        "INTERNAL",
        "PUBLIC"
      ]
    },
    "relationship_to_prior_attempts": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "minLength": 1
    },
    "attempt_tier": {
      "enum": [
        "DEVELOPMENT",
        "CONFIRMATORY",
        "PROSPECTIVE"
      ]
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "map_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{8,}$"
    },
    "external_seal_attestation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "disclosure_status": {
      "enum": [
        "SCHEDULED",
        "PUBLIC"
      ]
    },
    "disclosure_due_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "attempt_tier": {
            "enum": [
              "CONFIRMATORY",
              "PROSPECTIVE"
            ]
          }
        },
        "required": [
          "attempt_tier"
        ]
      },
      "then": {
        "required": [
          "external_seal_attestation_id"
        ],
        "properties": {
          "external_seal_attestation_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
