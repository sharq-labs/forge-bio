{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/research-program-attempt.v1.schema.json",
  "title": "Forge Bio Research Program Attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt_id",
    "schema_version",
    "benchmark_family",
    "benchmark_generation",
    "endpoint",
    "horizon",
    "primary_metric",
    "model_family",
    "result_status",
    "visibility",
    "relationship_to_prior_attempts",
    "digest"
  ],
  "properties": {
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "research-program-attempt-v1"
    },
    "benchmark_family": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_generation": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "string",
      "minLength": 1
    },
    "horizon": {
      "type": "string",
      "minLength": 1
    },
    "primary_metric": {
      "type": "string",
      "minLength": 1
    },
    "model_family": {
      "type": "string",
      "minLength": 1
    },
    "result_status": {
      "enum": [
        "POSITIVE",
        "NULL",
        "NEGATIVE",
        "INCONCLUSIVE",
        "FAILED_EXECUTION"
      ]
    },
    "visibility": {
      "enum": [
        "INTERNAL",
        "PUBLIC"
      ]
    },
    "relationship_to_prior_attempts": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "minLength": 1
    }
  }
}
