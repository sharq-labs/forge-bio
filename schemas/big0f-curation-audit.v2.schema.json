              ]
            },
            "then": {
              "properties": {
                "reviewer_labels": {
                  "additionalProperties": {
                    "properties": {
                      "second": {
                        "const": null
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "duplicate_reviewed": {
                  "const": true
                }
              },
              "required": [
                "duplicate_reviewed"
              ]
            },
            "then": {
              "properties": {
                "reviewer_labels": {
                  "additionalProperties": {
                    "properties": {
                      "second": {
                        "not": {
                          "const": null
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "non_event_duplicate_review_min_fraction": {
      "const": 0.3
    },
    "non_event_duplicate_review_min_count_floor": {
      "const": 30
    },
    "non_event_review_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duplicate_review_count",
        "duplicate_review_fraction",
        "disagreement_fraction",
        "agreement_statistic",
        "ac1",
        "ac1_lower90",
        "cohen_kappa",
        "confusion_matrix_digest",
        "unknown_fraction",
        "ambiguous_fraction"
      ],
      "properties": {
        "duplicate_review_count": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_review_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "disagreement_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "agreement_statistic": {
          "const": "GWET_AC1"
        },
        "ac1": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "ac1_lower90": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "cohen_kappa": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "confusion_matrix_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "unknown_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambiguous_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "event_case_set_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "non_event_case_set_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "duplicate_review_selection_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "adjudication_policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "sampling_key_commitment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "review_salt_commitment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$",
      "description": "SHA-256 of the custodian review salt, committed in the S6 bundle."
    },
    "first_review_label_set_registration_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$",
      "description": "Digest of the complete first-review label set (event and non-event cases), registered (public OSF + OTS) before the salt is revealed."
    },
    "retest_salt_commitment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$",
      "description": "SHA-256 of the second custodian salt s_ret, committed in S6."
    },
    "post_revision_label_set_registration_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      ],
      "description": "Registered digest of the complete post-revision first-review label set; required when a revision occurred, before s_ret is revealed."
    }
  }
}
