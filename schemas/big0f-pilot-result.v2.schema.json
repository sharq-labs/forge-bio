{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/big0f-pilot-result.v2.schema.json",
  "title": "Forge Bio BIG 0F Pilot Result v2",
  "description": "BIG 0F decision record. Every gate in threshold manifest v2 appears by ID with its value and outcome under the base, stricter and looser bound sets. Values are recomputed by the verifier from the bound source artifacts; free numbers are not accepted.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "base",
        "stricter",
        "looser",
        "source_artifact_digest"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "base": {
          "enum": [
            "PASS",
            "REDESIGN",
            "NO_GO",
            "INCONCLUSIVE"
          ]
        },
        "stricter": {
          "enum": [
            "PASS",
            "REDESIGN",
            "NO_GO",
            "INCONCLUSIVE",
            "EXEMPT"
          ]
        },
        "looser": {
          "enum": [
            "PASS",
            "REDESIGN",
            "NO_GO",
            "INCONCLUSIVE",
            "EXEMPT"
          ]
        },
        "source_artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      }
    },
    "task_agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statistic",
        "n_cases",
        "ac1",
        "ac1_lower90",
        "cohen_kappa",
        "percent_agreement",
        "confusion_matrix"
      ],
      "properties": {
        "statistic": {
          "const": "GWET_AC1"
        },
        "n_cases": {
          "type": "integer",
          "minimum": 0
        },
        "ac1": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "ac1_lower90": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "cohen_kappa": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "percent_agreement": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "confusion_matrix": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "required": [
    "pilot_id",
    "schema_version",
    "protocol_version",
    "primary_endpoint_subtype",
    "primary_metric_id",
    "pilot_model_evaluation_mode",
    "cutoff",
    "horizon",
    "disease_count",
    "candidate_event_family_count",
    "event_bearing_disease_count",
    "high_specificity_positive_family_count",
    "untouched_pool_disease_count",
    "bound_artifacts",
    "seal_attestation_ids",
    "gate_results",
    "agreement",
    "power",
    "nuisance_headroom",
    "reported_diagnostics",
    "prior_inconclusive_count",
    "decision_by_bound_set",
    "decision",
    "decision_reasons",
    "digest"
  ],
  "properties": {
    "pilot_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "big0f-pilot-result-v2"
    },
    "protocol_version": {
      "const": "BIG-0F-v0"
    },
    "primary_endpoint_subtype": {
      "const": "E1-NOVEL-STRICT"
    },
    "primary_metric_id": {
      "const": "EVENT_RANK_PERCENTILE_V1"
    },
    "pilot_model_evaluation_mode": {
      "const": "NUISANCE_ONLY"
    },
    "cutoff": {
      "enum": [
        "2005-12-31",
        "2008-12-31",
        "2011-12-31",
        "2014-12-31"
      ]
    },
    "horizon": {
      "enum": [
        "3y",
        "5y",
        "7y",
        "10y"
      ]
    },
    "disease_count": {
      "type": "integer",
      "minimum": 12,
      "maximum": 15
    },
    "candidate_event_family_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 150
    },
    "event_bearing_disease_count": {
      "type": "integer",
      "minimum": 0
    },
    "high_specificity_positive_family_count": {
      "type": "integer",
      "minimum": 0
    },
    "untouched_pool_disease_count": {
      "type": "integer",
      "minimum": 0
    },
