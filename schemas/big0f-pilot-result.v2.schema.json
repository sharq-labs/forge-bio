      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "GO"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "gate_results": {
            "additionalProperties": false,
            "patternProperties": {
              "^[A-Z0-9_]+$": {
                "properties": {
                  "base": {
                    "const": "PASS"
                  },
                  "stricter": {
                    "enum": [
                      "PASS",
                      "EXEMPT"
                    ]
                  }
                }
              }
            }
          },
          "decision_by_bound_set": {
            "properties": {
              "BASE": {
                "const": "GO"
              },
              "STRICTER": {
                "const": "GO"
              },
              "LOOSER": {
                "const": "GO"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "prior_inconclusive_count": {
            "const": 2
          }
        },
        "required": [
          "prior_inconclusive_count"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "enum": [
              "GO",
              "REDESIGN",
              "NO_GO"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agreement": {
            "properties": {
              "rule_revision_count": {
                "const": 1
              }
            },
            "required": [
              "rule_revision_count"
            ]
          }
        },
        "required": [
          "agreement"
        ]
      },
      "then": {
        "properties": {
          "agreement": {
            "required": [
              "retest_case_count"
            ],
            "properties": {
              "evaluated_on": {
                "const": "RETEST_SET"
              },
              "retest_case_count": {
                "type": "integer",
                "minimum": 30
              },
              "pre_revision_gated_tasks": {
                "type": "object",
                "required": [
                  "PRIMARY_ASSIGNMENT_ELIGIBILITY",
                  "PHENOTYPE_QUALIFICATION",
                  "NOVELTY_ELIGIBILITY",
                  "PRIMARY_POSITIVE_STATUS"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "agreement": {
            "properties": {
              "evaluated_on": {
                "const": "ORIGINAL_SET"
              },
              "pre_revision_gated_tasks": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agreement": {
            "properties": {
              "rule_revision_count": {
                "const": 1
              }
            },
            "required": [
              "rule_revision_count"
            ]
          }
        },
        "required": [
          "agreement"
        ]
      },
      "then": {
        "properties": {
          "bound_artifacts": {
            "properties": {
              "post_revision_label_set_registration_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-fA-F]{64}$"
              },
              "retest_salt_reveal_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-fA-F]{64}$"
              }
            }
          }
        }
      }
    }
  ]
