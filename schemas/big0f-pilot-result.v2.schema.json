        "frame_rule_digest",
        "required_field_registry_digest",
        "selection_registration_digest",
        "randomness_beacon_digest",
        "selection_provenance_digest",
        "outcome_discovery_run_digest",
        "recall_audit_digest",
        "nuisance_run_digest",
        "power_analysis_digest",
        "provider_audit_scope_digest",
        "provider_audit_digest",
        "curation_audit_digest",
        "adjudicator_independence_attestation_digest",
        "custodian_independence_attestation_digest",
