{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/confirmatory-program-budget.v1.schema.json",
  "title": "Forge Bio Confirmatory Program Budget v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "budget_id",
    "schema_version",
    "benchmark_family",
    "familywise_alpha",
    "allocation_method",
    "max_confirmatory_generations",
    "generation_allocations",
    "development_results_can_support_confirmatory_claim",
    "digest",
    "research_program_id",
    "program_scope_lock",
    "post_failure_policy"
  ],
  "properties": {
    "budget_id": {
      "const": "CPB-FORGE-BIO-B-TGT-E1-V0"
    },
    "schema_version": {
      "const": "confirmatory-program-budget-v1"
    },
    "benchmark_family": {
      "const": "B-TGT-E1"
    },
    "familywise_alpha": {
      "const": 0.05
    },
    "allocation_method": {
      "const": "FIXED_SPLIT",
      "description": "V0 holds the full 0.05 (INV-L11)."
    },
    "max_confirmatory_generations": {
      "const": 2
    },
    "generation_allocations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "generation_id",
          "allocated_alpha",
          "status"
        ],
        "properties": {
          "generation_id": {
            "type": "string",
            "minLength": 1
          },
          "allocated_alpha": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 0.05
          },
          "status": {
            "enum": [
              "PLANNED",
              "ACTIVE",
              "SPENT",
              "RETIRED"
            ]
          }
        }
      },
      "maxItems": 2
    },
    "development_results_can_support_confirmatory_claim": {
      "const": false
    },
    "post_failure_policy": {
      "const": "V1_REDESIGN_STAYS_IN_PROGRAM_BUDGET_NO_ALPHA_RESET_TWO_GENERATION_CAP_SPANS_VERSIONS",
      "description": "Budget carryover (INV-L7)."
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "research_program_id": {
      "const": "FORGE-BIO-B-TGT-E1-V0"
    },
    "program_scope_lock": {
      "const": "RENAMING_BENCHMARK_ENDPOINT_FRAME_OR_MODEL_DOES_NOT_RESET_BUDGET"
    }
  }
}
