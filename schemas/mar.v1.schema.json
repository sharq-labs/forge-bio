{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/mar.v1.schema.json",
  "title": "Forge Bio Model Analysis Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mar_id",
    "schema_version",
    "map_id",
    "map_digest",
    "benchmark_id",
    "benchmark_generation",
    "execution",
    "data",
    "verification",
    "coverage",
    "results",
    "bias_and_sensitivity",
    "governance",
    "interpretation"
  ],
  "properties": {
    "mar_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "mar-v1"
    },
    "map_id": {
      "type": "string"
    },
    "map_digest": {
      "type": "string"
    },
    "benchmark_id": {
      "type": "string"
    },
    "benchmark_generation": {
      "type": "string"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_commit",
        "environment_digest",
        "container_digest",
        "started_at",
        "completed_at",
        "ranking_artifact_digest"
      ],
      "properties": {
        "code_commit": {
          "type": "string"
        },
        "environment_digest": {
          "type": "string"
        },
        "container_digest": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "completed_at": {
          "type": "string"
        },
        "ranking_artifact_digest": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_snapshot_ids",
        "candidate_universe_digest",
        "future_outcome_snapshot_ids",
        "future_outcome_snapshot_digest",
        "outcome_ledger_digest",
        "adjudication_batch_digest",
        "evaluation_identity_bridge_digest",
        "validation_generation_id",
        "scientific_event_family_ledger_digest",
        "provider_coupling_assessment_digest",
        "provider_versions",
        "genomic_harmonization_artifact_ids"
      ],
      "properties": {
        "historical_snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_universe_digest": {
          "type": "string"
        },
        "future_outcome_snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "future_outcome_snapshot_digest": {
          "type": "string"
        },
        "outcome_ledger_digest": {
          "type": "string"
        },
        "adjudication_batch_digest": {
          "type": "string"
        },
        "evaluation_identity_bridge_digest": {
          "type": "string"
        },
        "validation_generation_id": {
          "type": "string"
        },
        "scientific_event_family_ledger_digest": {
          "type": "string"
        },
        "provider_coupling_assessment_digest": {
          "type": "string"
        },
        "provider_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "genomic_harmonization_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temporal_tests",
        "future_sentinel_tests",
        "watermark_tests",
        "identity_tests",
        "metric_golden_tests",
        "dependency_wall_tests",
        "genomic_identity_tests",
        "cross_anchor_event_reuse_tests",
        "preprocessing_lineage_tests",
        "reproducibility_result"
      ],
      "properties": {
        "temporal_tests": {
          "type": "string"
        },
        "future_sentinel_tests": {
          "type": "string"
        },
        "watermark_tests": {
          "type": "string"
        },
        "identity_tests": {
          "type": "string"
        },
        "metric_golden_tests": {
          "type": "string"
        },
        "dependency_wall_tests": {
          "type": "string"
        },
        "genomic_identity_tests": {
          "type": "string"
        },
        "cross_anchor_event_reuse_tests": {
          "type": "string"
        },
        "preprocessing_lineage_tests": {
          "type": "string"
        },
        "reproducibility_result": {
          "type": "string"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": true
    },
    "results": {
      "type": "object",
      "additionalProperties": true
    },
    "bias_and_sensitivity": {
      "type": "object",
      "additionalProperties": true
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_design_provenance_id",
        "lockbox_access_log_ref",
        "validation_generation_status",
        "validation_access_count",
        "validation_max_disclosure_level",
        "adjudication_blinding_status",
        "adjudication_summary",
        "deviations"
      ],
      "properties": {
        "benchmark_design_provenance_id": {
          "type": "string"
        },
        "lockbox_access_log_ref": {
          "type": "string"
        },
        "validation_generation_status": {
          "type": "string"
        },
        "validation_access_count": {
          "type": "integer",
          "minimum": 0
        },
        "validation_max_disclosure_level": {
          "enum": [
            "AGGREGATE_ONLY",
            "SUBGROUP",
            "PER_CASE",
            "FULL_LABEL"
          ]
        },
        "adjudication_blinding_status": {
          "type": "string"
        },
        "adjudication_summary": {
          "type": "string"
        },
        "deviations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_maturity_level",
        "applicability_domain",
        "limitations",
        "failed_analyses",
        "scientific_interpretation"
      ],
      "properties": {
        "claim_maturity_level": {
          "type": "string"
        },
        "applicability_domain": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failed_analyses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scientific_interpretation": {
          "type": "string"
        }
      }
    }
  }
}
