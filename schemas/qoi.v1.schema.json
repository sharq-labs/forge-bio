{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/qoi.v1.schema.json",
  "title": "Forge Bio Question of Interest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "schema_version",
    "benchmark_family",
    "benchmark_role",
    "hypothesis_type",
    "disease_scope",
    "historical_cutoff",
    "candidate_universe_policy_id",
    "future_endpoint",
    "evaluation_horizon",
    "estimand_id",
    "primary_metric_id",
    "primary_review_budget_or_k",
    "secondary_all_frame_utility_metric_id",
    "baseline_family_ids",
    "discoverability_control_id",
    "context_of_use_id",
    "claim_boundary"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "qoi-v1"
    },
    "benchmark_family": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_role": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis_type": {
      "type": "string",
      "minLength": 1
    },
    "disease_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regime",
        "inclusion_policy_id",
        "exclusion_policy_id"
      ],
      "properties": {
        "regime": {
          "type": "string"
        },
        "inclusion_policy_id": {
          "type": "string"
        },
        "exclusion_policy_id": {
          "type": "string"
        }
      }
    },
    "historical_cutoff": {
      "type": "string",
      "minLength": 1
    },
    "candidate_universe_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "future_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint_family",
        "primary_subtype",
        "endpoint_policy_version",
        "evidence_quality_policy_version",
        "pre_t_genetic_state_policy_version",
        "phenotype_match_policy_version",
        "gene_assignment_policy_version",
        "replication_policy_version"
      ],
      "properties": {
        "endpoint_family": {
          "type": "string"
        },
        "primary_subtype": {
          "type": "string"
        },
        "endpoint_policy_version": {
          "type": "string"
        },
        "evidence_quality_policy_version": {
          "type": "string"
        },
        "pre_t_genetic_state_policy_version": {
          "type": "string"
        },
        "phenotype_match_policy_version": {
          "type": "string"
        },
        "gene_assignment_policy_version": {
          "type": "string"
        },
        "replication_policy_version": {
          "type": "string"
        }
      }
    },
    "evaluation_horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration",
        "observation_end_policy"
      ],
      "properties": {
        "duration": {
          "type": "string"
        },
        "observation_end_policy": {
          "type": "string"
        }
      }
    },
    "estimand_id": {
      "type": "string"
    },
    "primary_metric_id": {
      "type": "string"
    },
    "primary_review_budget_or_k": {
      "type": "string"
    },
    "secondary_all_frame_utility_metric_id": {
      "type": "string"
    },
    "baseline_family_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "discoverability_control_id": {
      "type": "string"
    },
    "context_of_use_id": {
      "type": "string"
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
