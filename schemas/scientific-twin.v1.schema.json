{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/scientific-twin.v1.schema.json",
  "title": "Forge Bio Scientific Twin v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "twin_id",
    "schema_version",
    "terminology_scope",
    "twin_family",
    "subject_entity_ids",
    "maturity_level",
    "scientific_operating_mode",
    "historical_data_policy",
    "profile_snapshot_ids",
    "evidence_snapshot_ids",
    "verification_artifact_ids",
    "validation_artifact_ids",
    "uncertainty_bundle_ref",
    "applicability_domain_ref",
    "knowledge_watermark",
    "digest"
  ],
  "properties": {
    "twin_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "scientific-twin-v1"
    },
    "terminology_scope": {
      "const": "FORGE_BIO_RESEARCH_SCIENTIFIC_TWIN"
    },
    "twin_family": {
      "enum": [
        "DISEASE_TWIN",
        "PATHOGEN_TWIN",
        "PATHOGEN_HOST_TWIN",
        "THERAPEUTIC_TWIN"
      ]
    },
    "subject_entity_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maturity_level": {
      "enum": [
        "T0_PROFILE_ONLY",
        "T1_DYNAMIC_KNOWLEDGE_TWIN",
        "T2_MECHANISTIC_TWIN",
        "T3_VALIDATED_PREDICTIVE_TWIN",
        "T4_VALIDATED_INTERVENTION_SIMULATION_TWIN"
      ]
    },
    "scientific_operating_mode": {
      "enum": [
        "STRICT_HISTORICAL",
        "HISTORICAL_INPUT_MODERN_PRIOR",
        "CURRENT_DISCOVERY"
      ]
    },
    "historical_data_policy": {
      "enum": [
        "ARCHIVED_ONLY",
        "RECONSTRUCTED_ALLOWED"
      ]
    },
    "cutoff": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "profile_snapshot_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_snapshot_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "state_definition_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "state_model_artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parameter_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "update_policy_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "prediction_spec_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "map_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "mar_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_generation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "benchmark_design_provenance_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "perturbation_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sensitivity_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "causal_assumption_set_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "intervention_semantics_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "identifiability_status": {
      "enum": [
        "NOT_APPLICABLE",
        "IDENTIFIED",
        "PARTIALLY_IDENTIFIED",
        "ASSUMPTION_DEPENDENT",
        "NOT_IDENTIFIED",
        "UNKNOWN"
      ]
    },
    "verification_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uncertainty_bundle_ref": {
      "type": "string",
      "minLength": 1
    },
    "applicability_domain_ref": {
      "type": "string",
      "minLength": 1
    },
    "knowledge_watermark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "NON_KNOWLEDGE_BEARING",
            "DATED",
            "UNKNOWN"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "DATED"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "date"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "NON_KNOWLEDGE_BEARING",
                  "UNKNOWN"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "date": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "digest": {
      "type": "string",
      "minLength": 1
    },
    "credibility_assessment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_execution_kind": {
      "enum": [
        "STATIC_GRAPH",
        "ANALYTIC",
        "NUMERICAL_DETERMINISTIC",
        "NUMERICAL_STOCHASTIC",
        "HYBRID"
      ]
    },
    "numerical_verification_artifact_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scientific_operating_mode": {
            "enum": [
              "STRICT_HISTORICAL",
              "HISTORICAL_INPUT_MODERN_PRIOR"
            ]
          }
        },
        "required": [
          "scientific_operating_mode"
        ]
      },
      "then": {
        "required": [
          "cutoff"
        ],
        "properties": {
          "cutoff": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "maturity_level": {
            "enum": [
              "T1_DYNAMIC_KNOWLEDGE_TWIN",
              "T2_MECHANISTIC_TWIN",
              "T3_VALIDATED_PREDICTIVE_TWIN",
              "T4_VALIDATED_INTERVENTION_SIMULATION_TWIN"
            ]
          }
        },
        "required": [
          "maturity_level"
        ]
      },
      "then": {
        "required": [
          "state_definition_id",
          "update_policy_artifact_id",
          "credibility_assessment_id",
          "model_execution_kind"
        ],
        "properties": {
          "state_definition_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_snapshot_ids": {
            "minItems": 1
          },
          "update_policy_artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "credibility_assessment_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "maturity_level": {
            "enum": [
              "T2_MECHANISTIC_TWIN",
              "T3_VALIDATED_PREDICTIVE_TWIN",
              "T4_VALIDATED_INTERVENTION_SIMULATION_TWIN"
            ]
          }
        },
        "required": [
          "maturity_level"
        ]
      },
      "then": {
        "required": [
          "state_model_artifact_id",
          "parameter_artifact_ids",
          "credibility_assessment_id",
          "model_execution_kind"
        ],
        "properties": {
          "state_model_artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "parameter_artifact_ids": {
            "minItems": 1
          },
          "verification_artifact_ids": {
            "minItems": 1
          },
          "credibility_assessment_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "maturity_level": {
            "enum": [
              "T3_VALIDATED_PREDICTIVE_TWIN",
              "T4_VALIDATED_INTERVENTION_SIMULATION_TWIN"
            ]
          }
        },
        "required": [
          "maturity_level"
        ]
      },
      "then": {
        "required": [
          "prediction_spec_id",
          "map_id",
          "mar_ids",
          "validation_generation_id",
          "benchmark_design_provenance_id",
          "credibility_assessment_id",
          "model_execution_kind"
        ],
        "properties": {
          "prediction_spec_id": {
            "type": "string",
            "minLength": 1
          },
          "map_id": {
            "type": "string",
            "minLength": 1
          },
          "mar_ids": {
            "minItems": 1
          },
          "validation_generation_id": {
            "type": "string",
            "minLength": 1
          },
          "benchmark_design_provenance_id": {
            "type": "string",
            "minLength": 1
          },
          "validation_artifact_ids": {
            "minItems": 1
          },
          "credibility_assessment_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "maturity_level": {
            "const": "T4_VALIDATED_INTERVENTION_SIMULATION_TWIN"
          }
        },
        "required": [
          "maturity_level"
        ]
      },
      "then": {
        "required": [
          "perturbation_artifact_ids",
          "sensitivity_artifact_ids",
          "causal_assumption_set_id",
          "intervention_semantics_id",
          "identifiability_status"
        ],
        "properties": {
          "perturbation_artifact_ids": {
            "minItems": 1
          },
          "sensitivity_artifact_ids": {
            "minItems": 1
          },
          "causal_assumption_set_id": {
            "type": "string",
            "minLength": 1
          },
          "intervention_semantics_id": {
            "type": "string",
            "minLength": 1
          },
          "identifiability_status": {
            "enum": [
              "IDENTIFIED",
              "PARTIALLY_IDENTIFIED",
              "ASSUMPTION_DEPENDENT"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "model_execution_kind": {
            "enum": [
              "NUMERICAL_DETERMINISTIC",
              "NUMERICAL_STOCHASTIC",
              "HYBRID"
            ]
          }
        },
        "required": [
          "model_execution_kind"
        ]
      },
      "then": {
        "required": [
          "numerical_verification_artifact_id"
        ],
        "properties": {
          "numerical_verification_artifact_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
