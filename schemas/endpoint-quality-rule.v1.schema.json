{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/endpoint-quality-rule.v1.schema.json",
  "title": "Forge Bio Endpoint Evidence Quality Rule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "schema_version",
    "status",
    "endpoint_subtype",
    "provider_audit_ref",
    "criteria",
    "independence_requirement",
    "phenotype_policy_ref",
    "gene_assignment_policy_ref",
    "genomic_harmonization_policy_ref",
    "digest"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "endpoint-quality-rule-v1"
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "FROZEN"
      ]
    },
    "endpoint_subtype": {
      "enum": [
        "E1-NOVEL-STRICT",
        "E1-MATURATION",
        "E1-REPLICATION",
        "E1-CROSSMODAL"
      ]
    },
    "provider_audit_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "scientific_dimension",
          "field_or_artifact",
          "operator",
          "required",
          "justification"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "scientific_dimension": {
            "enum": [
              "STUDY_DESIGN",
              "STATISTICAL_STRENGTH",
              "SAMPLE_SIZE",
              "INDEPENDENCE",
              "PHENOTYPE_MATCH",
              "GENOMIC_HARMONIZATION",
              "ALLELE_DIRECTION",
              "POPULATION_ANCESTRY",
              "REPLICATION",
              "HETEROGENEITY",
              "GENE_ASSIGNMENT",
              "HISTORICAL_NOVELTY",
              "SOURCE_QUALITY"
            ]
          },
          "field_or_artifact": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "REQUIRE",
              "EQ",
              "NE",
              "GT",
              "GE",
              "LT",
              "LE",
              "IN",
              "NOT_IN"
            ]
          },
          "value": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": [
                    "number",
                    "string",
                    "boolean"
                  ]
                }
              }
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "justification": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operator": {
                  "const": "REQUIRE"
                }
              },
              "required": [
                "operator"
              ]
            },
            "then": {
              "properties": {
                "required": {
                  "const": true
                }
              },
              "not": {
                "required": [
                  "value"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator": {
                  "enum": [
                    "GT",
                    "GE",
                    "LT",
                    "LE"
                  ]
                }
              },
              "required": [
                "operator"
              ]
            },
            "then": {
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "number"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator": {
                  "enum": [
                    "EQ",
                    "NE"
                  ]
                }
              },
              "required": [
                "operator"
              ]
            },
            "then": {
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "string",
                    "boolean"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator": {
                  "enum": [
                    "IN",
                    "NOT_IN"
                  ]
                }
              },
              "required": [
                "operator"
              ]
            },
            "then": {
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": [
                      "number",
                      "string",
                      "boolean"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    "independence_requirement": {
      "enum": [
        "REQUIRED",
        "SUBTYPE_SPECIFIC",
        "NOT_APPLICABLE"
      ]
    },
    "phenotype_policy_ref": {
      "const": "ADR-008"
    },
    "gene_assignment_policy_ref": {
      "const": "BIG0F-ADJUDICATION-V1"
    },
    "genomic_harmonization_policy_ref": {
      "const": "ADR-011"
    },
    "frozen_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "FROZEN"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "frozen_at"
        ],
        "properties": {
          "frozen_at": {
            "type": "string",
            "format": "date-time"
          },
          "independence_requirement": {
            "const": "REQUIRED"
          },
          "criteria": {
            "minItems": 11,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "scientific_dimension": {
                      "const": "STUDY_DESIGN"
                    }
                  },
                  "required": [
                    "scientific_dimension"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "scientific_dimension": {
                      "const": "STATISTICAL_STRENGTH"
                    }
                  },
                  "required": [
                    "scientific_dimension"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "scientific_dimension": {
                      "const": "SAMPLE_SIZE"
                    }
                  },
                  "required": [
                    "scientific_dimension"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "scientific_dimension": {
                      "const": "INDEPENDENCE"
                    }
                  },
                  "required": [
                    "scientific_dimension"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "scientific_dimension": {
                      "const": "PHENOTYPE_MATCH"
                    }
                  },
                  "required": [
                    "scientific_dimension"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "scientific_dimension": {
                      "const": "GENOMIC_HARMONIZATION"
                    }
                  },
                  "required": [
                    "scientific_dimension"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "scientific_dimension": {
                      "const": "ALLELE_DIRECTION"
                    }
                  },
                  "required": [
                    "scientific_dimension"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "scientific_dimension": {
                      "const": "POPULATION_ANCESTRY"
                    }
                  },
                  "required": [
                    "scientific_dimension"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "scientific_dimension": {
                      "const": "GENE_ASSIGNMENT"
                    }
                  },
                  "required": [
                    "scientific_dimension"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "scientific_dimension": {
                      "const": "HISTORICAL_NOVELTY"
                    }
                  },
                  "required": [
                    "scientific_dimension"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "scientific_dimension": {
                      "const": "SOURCE_QUALITY"
                    }
                  },
                  "required": [
                    "scientific_dimension"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  ]
}
