{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/research-program-ledger.v1.schema.json",
  "title": "Forge Bio Research Program Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_id",
    "schema_version",
    "research_program_id",
    "confirmatory_program_budget_id",
    "attempts",
    "digest",
    "ledger_sequence",
    "previous_ledger_digest",
    "external_anchor_attestation_id",
    "external_anchor_attestation_digest",
    "cumulative_confirmatory_alpha_spent",
    "generation_state_transitions",
    "external_anchor_authority_type"
  ],
  "properties": {
    "ledger_id": {
      "const": "RPL-FORGE-BIO-B-TGT-E1-V0"
    },
    "schema_version": {
      "const": "research-program-ledger-v1"
    },
    "research_program_id": {
      "const": "FORGE-BIO-B-TGT-E1-V0"
    },
    "confirmatory_program_budget_id": {
      "const": "CPB-FORGE-BIO-B-TGT-E1-V0"
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id",
          "attempt_tier",
          "attempt_index",
          "allocation_generation_id",
          "allocated_alpha",
          "result_status"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "attempt_tier": {
            "enum": [
              "DEVELOPMENT",
              "CONFIRMATORY",
              "PROSPECTIVE"
            ]
          },
          "attempt_index": {
            "type": "integer",
            "minimum": 1
          },
          "allocation_generation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "allocated_alpha": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 0.05
          },
          "result_status": {
            "enum": [
              "POSITIVE",
              "NULL",
              "NEGATIVE",
              "INCONCLUSIVE",
              "FAILED_EXECUTION"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "attempt_tier": {
                  "enum": [
                    "CONFIRMATORY",
                    "PROSPECTIVE"
                  ]
                }
              },
              "required": [
                "attempt_tier"
              ]
            },
            "then": {
              "properties": {
                "allocation_generation_id": {
                  "type": "string",
                  "minLength": 1
                },
                "allocated_alpha": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 0.05
                }
              }
            },
            "else": {
              "properties": {
                "allocation_generation_id": {
                  "type": "null"
                },
                "allocated_alpha": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "ledger_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "previous_ledger_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      ]
    },
    "external_anchor_attestation_id": {
      "type": "string",
      "minLength": 1
    },
    "external_anchor_attestation_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "cumulative_confirmatory_alpha_spent": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.05
    },
    "generation_state_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "generation_id",
          "from_state",
          "to_state",
          "transitioned_at",
          "evidence_digest"
        ],
        "properties": {
          "generation_id": {
            "type": "string",
            "minLength": 1
          },
          "from_state": {
            "enum": [
              "PLANNED",
              "ACTIVE",
              "SPENT",
              "RETIRED"
            ]
          },
          "to_state": {
            "enum": [
              "PLANNED",
              "ACTIVE",
              "SPENT",
              "RETIRED"
            ]
          },
          "transitioned_at": {
            "type": "string",
            "format": "date-time",
            "description": "Informational. Order of ledger states is proven by ledger_sequence and the anchor attestation's seal_time, not by this field."
          },
          "evidence_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          }
        },
        "anyOf": [
          {
            "properties": {
              "from_state": {
                "const": "PLANNED"
              },
              "to_state": {
                "const": "ACTIVE"
              }
            }
          },
          {
            "properties": {
              "from_state": {
                "const": "ACTIVE"
              },
              "to_state": {
                "const": "SPENT"
              }
            }
          },
          {
            "properties": {
              "from_state": {
                "const": "PLANNED"
              },
              "to_state": {
                "const": "RETIRED"
              }
            }
          },
          {
            "properties": {
              "from_state": {
                "const": "ACTIVE"
              },
              "to_state": {
                "const": "RETIRED"
              }
            }
          }
        ]
      }
    },
    "external_anchor_authority_type": {
      "const": "PUBLIC_REGISTRY",
      "description": "Every ledger state is anchored in a public registry; the published head is the only valid head (INV-L2)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ledger_sequence": {
            "const": 0
          }
        },
        "required": [
          "ledger_sequence"
        ]
      },
      "then": {
        "properties": {
          "previous_ledger_digest": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_ledger_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          }
        }
      }
    }
  ]
}
