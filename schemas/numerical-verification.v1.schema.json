{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/numerical-verification.v1.schema.json",
  "title": "Forge Bio Numerical Verification Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_id",
    "schema_version",
    "model_artifact_id",
    "solver_or_engine",
    "solver_version",
    "numerical_method",
    "tolerances",
    "convergence_study_status",
    "stochastic_replication_status",
    "numerical_error_estimate",
    "invariant_or_residual_checks",
    "reproducibility_tolerance",
    "verdict",
    "digest",
    "numerical_problem_type"
  ],
  "properties": {
    "verification_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "numerical-verification-v1"
    },
    "model_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "solver_or_engine": {
      "type": "string",
      "minLength": 1
    },
    "solver_version": {
      "type": "string",
      "minLength": 1
    },
    "numerical_method": {
      "type": "string",
      "minLength": 1
    },
    "tolerances": {
      "type": "object",
      "minProperties": 1
    },
    "discretization_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestep_or_resolution_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "convergence_study_status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "stochastic_replication_status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "numerical_error_estimate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "invariant_or_residual_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reference_solution_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reproducibility_tolerance": {
      "type": "string",
      "minLength": 1
    },
    "hardware_runtime_context": {
      "type": [
        "string",
        "null"
      ]
    },
    "verdict": {
      "enum": [
        "ADEQUATE",
        "CONDITIONAL",
        "INADEQUATE",
        "UNKNOWN"
      ]
    },
    "digest": {
      "type": "string",
      "minLength": 1
    },
    "numerical_problem_type": {
      "enum": [
        "ANALYTIC",
        "DISCRETE_EXACT",
        "CONTINUOUS_NUMERICAL",
        "STOCHASTIC_NUMERICAL",
        "HYBRID_NUMERICAL"
      ]
    },
    "not_applicable_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "ADEQUATE"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "convergence_study_status": {
            "enum": [
              "PASS",
              "NOT_APPLICABLE"
            ]
          },
          "stochastic_replication_status": {
            "enum": [
              "PASS",
              "NOT_APPLICABLE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "ADEQUATE"
          },
          "numerical_problem_type": {
            "enum": [
              "CONTINUOUS_NUMERICAL",
              "STOCHASTIC_NUMERICAL",
              "HYBRID_NUMERICAL"
            ]
          }
        },
        "required": [
          "verdict",
          "numerical_problem_type"
        ]
      },
      "then": {
        "properties": {
          "convergence_study_status": {
            "const": "PASS"
          },
          "numerical_error_estimate": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "convergence_study_status": {
            "const": "NOT_APPLICABLE"
          }
        },
        "required": [
          "convergence_study_status"
        ]
      },
      "then": {
        "required": [
          "not_applicable_reason"
        ],
        "properties": {
          "not_applicable_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
