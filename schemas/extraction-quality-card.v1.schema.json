{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/extraction-quality-card.v1.schema.json",
  "title": "Forge Bio Extraction Quality Card v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quality_card_id",
    "schema_version",
    "extractor_id",
    "extractor_version",
    "task_definition",
    "domain_scope",
    "gold_set_id",
    "sample_size",
    "precision",
    "recall",
    "abstention_rate",
    "known_failure_modes",
    "qualification_status",
    "digest"
  ],
  "properties": {
    "quality_card_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "extraction-quality-card-v1"
    },
    "extractor_id": {
      "type": "string",
      "minLength": 1
    },
    "extractor_version": {
      "type": "string",
      "minLength": 1
    },
    "task_definition": {
      "type": "string",
      "minLength": 1
    },
    "domain_scope": {
      "type": "string",
      "minLength": 1
    },
    "gold_set_id": {
      "type": "string",
      "minLength": 1
    },
    "sample_size": {
      "type": "integer",
      "minimum": 1
    },
    "precision": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "recall": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "abstention_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "inter_reviewer_agreement": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "known_failure_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qualification_status": {
      "enum": [
        "QUALIFIED",
        "CONDITIONAL",
        "UNQUALIFIED",
        "UNKNOWN"
      ]
    },
    "qualification_condition": {
      "type": [
        "string",
        "null"
      ]
    },
    "digest": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "qualification_status": {
            "const": "CONDITIONAL"
          }
        },
        "required": [
          "qualification_status"
        ]
      },
      "then": {
        "required": [
          "qualification_condition"
        ],
        "properties": {
          "qualification_condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
