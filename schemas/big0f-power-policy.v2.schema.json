{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/big0f-power-policy.v2.schema.json",
  "title": "Forge Bio BIG 0F Power and Variance Policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "schema_version",
    "status",
    "sealed_by_attestation_id",
    "biological_arm_observed_in_big0f",
    "confirmatory_test_ref",
    "alpha_one_sided",
    "planning_effect",
    "target_power",
    "stage_a_pool_sufficiency_screen",
    "stage_b_confirmatory_power_gate",
    "zero_event_policy",
    "prohibitions"
  ],
  "properties": {
    "policy_id": {
      "const": "BIG0F-POWER-POLICY-V2"
    },
    "schema_version": {
      "const": "big0f-power-policy-v2"
    },
    "status": {
      "enum": [
        "SEAL_CANDIDATE",
        "SEALED"
      ]
    },
    "sealed_by_attestation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "biological_arm_observed_in_big0f": {
      "const": false
    },
    "confirmatory_test_ref": {
      "const": "V0_FREEZE_STATEMENT_SECTION_3_PAIRED_SIGN_FLIP_MEAN_DELTA_V1"
    },
    "alpha_one_sided": {
      "const": 0.05
    },
    "planning_effect": {
      "const": 0.05
    },
    "target_power": {
      "const": 0.8
    },
    "stage_a_pool_sufficiency_screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_role",
        "event_level_sd_upper_bound",
        "percentile_bootstrap_alone_allowed",
        "bootstrap_replicates",
        "sd_seed_domain",
        "variance_model",
        "innovation_distribution",
        "clip_range",
        "simulation_datasets",
        "signflips_per_dataset",
        "simulation_seed_domain",
        "power_decision_rule",
        "event_bearing_fraction_bound",
        "normal_approximation_role",
        "scenarios",
        "decision_semantics",
        "dlvs_reservation_rule",
        "threshold_gates"
      ],
      "properties": {
        "gate_role": {
          "const": "BIG0F_GO_GATE"
        },
        "event_level_sd_upper_bound": {
          "const": "MAX_OF_CHI_SQUARE_UPPER95_AND_DISEASE_CLUSTER_BCA_UPPER95"
        },
        "percentile_bootstrap_alone_allowed": {
          "const": false
        },
        "bootstrap_replicates": {
          "const": 10000
        },
        "sd_seed_domain": {
          "const": "power-sd"
        },
        "variance_model": {
          "const": "TAU2_PLUS_SIGMA_E2_OVER_M_WITH_SIGMA_E_EQUAL_SQRT_2_1_MINUS_RHO_TIMES_S_E_UP"
        },
        "innovation_distribution": {
          "const": "STANDARDIZED_STUDENT_T_DF5"
        },
        "clip_range": {
          "const": [
            -1,
            1
          ]
        },
        "simulation_datasets": {
          "const": 10000
        },
        "signflips_per_dataset": {
          "const": 2000
        },
        "simulation_seed_domain": {
          "const": "power-sim"
        },
        "power_decision_rule": {
          "const": "POWER_MINUS_2_MCSE_GE_TARGET"
        },
        "event_bearing_fraction_bound": {
          "const": "WILSON_LOWER_95"
        },
        "normal_approximation_role": {
          "const": "SECONDARY_REPORT_ONLY"
        },
        "scenarios": {
          "const": {
            "OPTIMISTIC": {
              "rho": 0.8,
              "tau": 0.05,
              "role": "NO_GO_BOUNDARY"
            },
            "PLANNING": {
              "rho": 0.5,
              "tau": 0.05,
              "role": "GO_BOUNDARY"
            },
            "HETEROGENEOUS": {
              "rho": 0.5,
              "tau": 0.1,
              "role": "REPORTED"
            },
            "PESSIMISTIC": {
              "rho": 0.0,
              "tau": 0.05,
              "role": "REPORTED"
            }
          }
        },
        "decision_semantics": {
          "const": {
            "pool_minus_reservation_ge_f_req_planning": "POWER_GATE_PASS",
            "pool_minus_reservation_between_optimistic_and_planning": "REDESIGN",
            "pool_minus_reservation_lt_f_req_optimistic": "NO_GO",
            "missing_or_unreconstructable_input": "INCONCLUSIVE"
          }
        },
        "dlvs_reservation_rule": {
          "const": "MAX_0_CEIL_20_MINUS_EVENT_BEARING_PILOT_DISEASES_OVER_P_EB_WILSON_LOWER"
        },
        "threshold_gates": {
          "const": [
            "POWER_POOL_SUFFICIENCY",
            "POWER_POOL_OPTIMISTIC_FLOOR"
          ]
        }
      }
    },
    "stage_b_confirmatory_power_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_role",
        "study",
        "allowed_diseases",
        "min_event_bearing_diseases",
        "model_requirement",
        "sigma_e_planning",
        "tau_planning",
        "rho_planning",
        "bootstrap_replicates",
        "external_sources",
        "decision_semantics",
        "additional_disease_draw",
        "variance_model",
        "bootstrap_seed_domain"
      ],
      "properties": {
        "gate_role": {
          "const": "P1_BEFORE_CONFIRMATORY_SEAL"
        },
        "study": {
          "const": "DEVELOPMENT_LIFT_AND_VARIANCE_STUDY"
        },
        "allowed_diseases": {
          "const": "DEVELOPMENT_EXPOSED_ONLY"
        },
        "min_event_bearing_diseases": {
          "type": "integer",
          "minimum": 20
        },
        "model_requirement": {
          "const": "INTENDED_CONFIRMATORY_MODEL_FAMILY_AND_VERSION"
        },
        "sigma_e_planning": {
          "const": "MAX_OF_CHI_SQUARE_UPPER95_AND_DISEASE_FAMILY_CLUSTER_BCA_UPPER95"
        },
        "tau_planning": {
          "const": "BOOTSTRAP_UPPER95_FLOOR_0_02"
        },
        "rho_planning": {
          "const": "REPORTED_ONLY_NOT_USED_SIGMA_E_IS_MEASURED_PAIRED_DIFFERENCE_SD"
        },
        "bootstrap_replicates": {
          "const": 10000
        },
        "external_sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed",
            "registry_schema",
            "min_diseases_per_source",
            "combination_rule"
          ],
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "registry_schema": {
              "const": "big0f-variance-source-registry-v2"
            },
            "min_diseases_per_source": {
              "type": "integer",
              "minimum": 20
            },
            "combination_rule": {
              "const": "MAX_PLANNING_SD_SOURCES_CAN_ONLY_RAISE"
            }
          }
        },
        "decision_semantics": {
          "const": {
            "pool_after_dlvs_ge_f_req": "CONFIRMATORY_SEAL_ALLOWED",
            "pool_after_dlvs_lt_f_req": "REDESIGN_NEW_VERSION"
          }
        },
        "additional_disease_draw": {
          "const": "CUSTODIAN_FROM_UNTOUCHED_POOL_ASCENDING_HMAC_DLVS_DOMAIN_UNTIL_20_EVENT_BEARING"
        },
        "variance_model": {
          "const": "TAU2_PLUS_MEASURED_PAIRED_SIGMA_E2_OVER_M"
        },
        "bootstrap_seed_domain": {
          "const": "power-sd"
        }
      }
    },
    "zero_event_policy": {
      "const": "RETAIN_IN_FRAME_NO_FABRICATED_RANK_SCORE_REPORT_ALL_FRAME_UTILITY"
    },
    "prohibitions": {
      "const": [
        "CALLER_SUPPLIED_SD",
        "BIG0F_BIOLOGICAL_ARM",
        "ANALYST_CHOSEN_SEED",
        "POST_RESULT_SCENARIO_CHOICE"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SEALED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "sealed_by_attestation_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "sealed_by_attestation_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
