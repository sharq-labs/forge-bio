{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/big0f-power-analysis.v1.schema.json",
  "title": "Forge Bio BIG 0F Power Analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "power_analysis_id",
    "schema_version",
    "method",
    "nuisance_run_digest",
    "nuisance_run_id",
    "sd_derivation_method",
    "alpha",
    "target_power",
    "minimum_scientifically_meaningful_effect",
    "simulation_replicates",
    "simulation_seed",
    "estimated_power",
    "required_confirmatory_disease_count",
    "required_high_specificity_positive_count",
    "input_provenance_ids",
    "engine_sha256",
    "digest",
    "power_input_derivation_contract_digest",
    "variance_source_class",
    "go_eligible_variance_evidence",
    "variance_source_artifact_digests",
    "primary_planning_sd",
    "scenario_results",
    "primary_scenario_id",
    "dependence_assumption_digest"
  ],
  "properties": {
    "power_analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "big0f-power-analysis-v1"
    },
    "method": {
      "const": "PAIRED_DISEASE_MONTE_CARLO_NORMAL_APPROX"
    },
    "alpha": {
      "const": 0.05
    },
    "target_power": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 0.99
    },
    "minimum_scientifically_meaningful_effect": {
      "const": 0.05
    },
    "simulation_replicates": {
      "type": "integer",
      "minimum": 10000
    },
    "simulation_seed": {
      "type": "integer",
      "minimum": 0
    },
    "estimated_power": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "required_confirmatory_disease_count": {
      "type": "integer",
      "minimum": 1
    },
    "required_high_specificity_positive_count": {
      "type": "integer",
      "minimum": 1
    },
    "input_provenance_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "engine_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "sd_derivation_method": {
      "enum": [
        "INDEPENDENT_DEVELOPMENT_SAME_ESTIMAND_BOOTSTRAP_UPPER95_V1",
        "PILOT_NUISANCE_DISEASE_MEAN_RANK_SD_PROXY_V1"
      ]
    },
    "nuisance_run_id": {
      "type": "string",
      "minLength": 1
    },
    "nuisance_run_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "power_input_derivation_contract_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "variance_source_class": {
      "enum": [
        "INDEPENDENT_DEVELOPMENT_SAME_ESTIMAND",
        "PILOT_NUISANCE_PROXY_ONLY"
      ]
    },
    "go_eligible_variance_evidence": {
      "type": "boolean"
    },
    "variance_source_artifact_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-fA-F]{64}$"
      }
    },
    "primary_planning_sd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "scenario_results": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "scenario_role",
          "sd_value",
          "dependence_adjustment_applied",
          "estimated_power",
          "required_confirmatory_disease_count",
          "source_artifact_digest"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "scenario_role": {
            "enum": [
              "PRIMARY_CONSERVATIVE",
              "INDEPENDENT_SOURCE",
              "DEPENDENCE_SENSITIVITY",
              "PILOT_NUISANCE_PROXY"
            ]
          },
          "sd_value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "dependence_adjustment_applied": {
            "type": "boolean"
          },
          "estimated_power": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "required_confirmatory_disease_count": {
            "type": "integer",
            "minimum": 1
          },
          "source_artifact_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          }
        }
      }
    },
    "primary_scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "dependence_assumption_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "variance_source_class": {
            "const": "INDEPENDENT_DEVELOPMENT_SAME_ESTIMAND"
          }
        },
        "required": [
          "variance_source_class"
        ]
      },
      "then": {
        "properties": {
          "go_eligible_variance_evidence": {
            "const": true
          },
          "sd_derivation_method": {
            "const": "INDEPENDENT_DEVELOPMENT_SAME_ESTIMAND_BOOTSTRAP_UPPER95_V1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "variance_source_class": {
            "const": "PILOT_NUISANCE_PROXY_ONLY"
          }
        },
        "required": [
          "variance_source_class"
        ]
      },
      "then": {
        "properties": {
          "go_eligible_variance_evidence": {
            "const": false
          },
          "sd_derivation_method": {
            "const": "PILOT_NUISANCE_DISEASE_MEAN_RANK_SD_PROXY_V1"
          }
        }
      }
    }
  ]
}
