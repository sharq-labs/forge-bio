{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/big0f-provider-audit.v2.schema.json",
  "title": "Forge Bio BIG 0F Provider Audit v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_id",
    "schema_version",
    "source_families",
    "required_field_cells",
    "provider_coupling",
    "ancestry_population_audit",
    "digest",
    "audit_scope_manifest_digest",
    "required_field_registry_digest",
    "selection_provenance_digest",
    "summary"
  ],
  "properties": {
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "big0f-provider-audit-v2"
    },
    "source_families": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_family_id",
          "family_kind",
          "provider_id",
          "historical_release_id",
          "release_evidence_digest"
        ],
        "properties": {
          "source_family_id": {
            "type": "string",
            "minLength": 1
          },
          "family_kind": {
            "enum": [
              "PRIMARY_PUBLICATION_METADATA",
              "GWAS_HISTORICAL",
              "IDENTITY_ONTOLOGY",
              "HISTORICAL_GENE_MODEL_ANNOTATION",
              "OTHER"
            ]
          },
          "provider_id": {
            "type": "string",
            "minLength": 1
          },
          "historical_release_id": {
            "type": "string",
            "minLength": 1
          },
          "release_evidence_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          }
        }
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "properties": {
              "family_kind": {
                "const": "PRIMARY_PUBLICATION_METADATA"
              }
            },
            "required": [
              "family_kind"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "family_kind": {
                "const": "GWAS_HISTORICAL"
              }
            },
            "required": [
              "family_kind"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "family_kind": {
                "const": "IDENTITY_ONTOLOGY"
              }
            },
            "required": [
              "family_kind"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "family_kind": {
                "const": "HISTORICAL_GENE_MODEL_ANNOTATION"
              }
            },
            "required": [
              "family_kind"
            ]
          },
          "minContains": 1
        }
      ]
    },
    "required_field_cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "disease_id",
          "source_family_id",
          "field_id",
          "criticality",
          "historical_release_obtainable",
          "release_version_identifiable",
          "field_existed_at_t",
          "value_reconstructable",
          "retrospectively_curated",
          "mapping_needed",
          "license_access_constraint",
          "coverage_grade",
          "evidence_digest",
          "time_scope",
          "available"
        ],
        "properties": {
          "disease_id": {
            "type": "string",
            "minLength": 1
          },
          "source_family_id": {
            "type": "string",
            "minLength": 1
          },
          "field_id": {
            "type": "string",
            "minLength": 1
          },
          "criticality": {
            "enum": [
              "CRITICAL",
              "REQUIRED"
            ]
          },
          "historical_release_obtainable": {
            "type": "boolean"
          },
          "release_version_identifiable": {
            "type": "boolean"
          },
          "field_existed_at_t": {
            "type": "boolean"
          },
          "value_reconstructable": {
            "type": "boolean"
          },
          "retrospectively_curated": {
            "type": "boolean"
          },
          "mapping_needed": {
            "type": "boolean"
          },
          "license_access_constraint": {
            "type": "boolean"
          },
          "coverage_grade": {
            "enum": [
              "HIGH",
              "MODERATE",
              "LOW",
              "UNKNOWN"
            ]
          },
          "evidence_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          },
          "time_scope": {
            "enum": [
              "AS_OF_T",
              "EVALUATION"
            ]
          },
          "available": {
            "type": "boolean",
            "description": "The registry availability predicate for this cell's time_scope; recomputed by the verifier from the component booleans."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "time_scope": {
                  "const": "AS_OF_T"
                },
                "available": {
                  "const": true
                }
              },
              "required": [
                "time_scope",
                "available"
              ]
            },
            "then": {
              "properties": {
                "historical_release_obtainable": {
                  "const": true
                },
                "release_version_identifiable": {
                  "const": true
                },
                "field_existed_at_t": {
                  "const": true
                },
                "value_reconstructable": {
                  "const": true
                },
                "retrospectively_curated": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "time_scope": {
                  "const": "EVALUATION"
                },
                "available": {
                  "const": true
                }
              },
              "required": [
                "time_scope",
                "available"
              ]
            },
            "then": {
              "properties": {
                "historical_release_obtainable": {
                  "const": true
                },
                "release_version_identifiable": {
                  "const": true
                },
                "value_reconstructable": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    },
    "provider_coupling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk",
        "shared_pipeline_fraction",
        "evidence_digests"
      ],
      "properties": {
        "risk": {
          "enum": [
            "LOW",
            "MODERATE",
            "HIGH",
            "UNKNOWN"
          ]
        },
        "shared_pipeline_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          }
        }
      }
    },
    "ancestry_population_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adequacy",
        "case_records",
        "evidence_digests",
        "adequacy_rule_id",
        "adequacy_rule_digest"
      ],
      "properties": {
        "adequacy": {
          "enum": [
            "ADEQUATE",
            "INADEQUATE",
            "UNKNOWN"
          ]
        },
        "case_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "metadata_available",
              "population_metadata_source_id",
              "provenance_digest"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "minLength": 1
              },
              "metadata_available": {
                "type": "boolean"
              },
              "population_metadata_source_id": {
                "type": "string",
                "minLength": 1
              },
              "provenance_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-fA-F]{64}$"
              }
            }
          }
        },
        "evidence_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          }
        },
        "adequacy_rule_id": {
          "type": "string",
          "minLength": 1
        },
        "adequacy_rule_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "audit_scope_manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "required_field_registry_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "selection_provenance_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_count",
        "required_field_availability",
        "source_family_kinds_present",
        "ancestry_metadata_coverage",
        "shared_pipeline_fraction_primary"
      ],
      "properties": {
        "cell_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Must equal the scope's expected_cell_count."
        },
        "required_field_availability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Gate REQUIRED_FIELD_AVAILABILITY: available cells / all cells in scope."
        },
        "source_family_kinds_present": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Gate SOURCE_FAMILY_KINDS_PRESENT."
        },
        "ancestry_metadata_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Gate ANCESTRY_METADATA_COVERAGE."
        },
        "shared_pipeline_fraction_primary": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Gate SHARED_PIPELINE_FRACTION_PRIMARY."
        }
      }
    }
  }
}
