{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/big0f-selection-provenance.v1.schema.json",
  "title": "Forge Bio BIG 0F Selection Provenance v1",
  "description": "Custodian-produced record of the 16-pair cutoff/horizon audit, the selected pair, and the beacon-ordered disease prefix. Contains aggregates and digests only; per-event raw universes stay in custody.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "evidence_digest"
      ],
      "properties": {
        "pass": {
          "type": "boolean"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      }
    },
    "aggregates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_size",
        "frame_cov_count",
        "frame_cov_fraction",
        "mean_raw_candidates_per_covered_disease"
      ],
      "properties": {
        "frame_size": {
          "type": "integer",
          "minimum": 0
        },
        "frame_cov_count": {
          "type": "integer",
          "minimum": 0
        },
        "frame_cov_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mean_raw_candidates_per_covered_disease": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  },
  "required": [
    "selection_id",
    "schema_version",
    "produced_by_role",
    "custodian_independence_attestation_digest",
    "frame_rule_digest",
    "required_field_registry_digest",
    "outcome_discovery_spec_digest",
    "threshold_manifest_digest",
    "candidate_pairs",
    "selected_pair_index",
    "frame_cov_digest",
    "selection_registration_digest",
    "randomness_beacon_digest",
    "ordered_prefix",
    "expansion_steps",
    "cap",
    "selected_disease_ids",
    "selected_event_family_ids",
    "digest"
  ],
  "properties": {
    "selection_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "big0f-selection-provenance-v1"
    },
    "produced_by_role": {
      "const": "SELECTION_CUSTODIAN"
    },
    "custodian_independence_attestation_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "frame_rule_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "required_field_registry_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "outcome_discovery_spec_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "threshold_manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "candidate_pairs": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cutoff",
            "horizon",
            "P_prov",
            "P_obs",
            "P_cov",
            "P_anchor",
            "P_evt",
            "pair_passes",
            "aggregates",
            "raw_universe_digest"
          ],
          "properties": {
            "cutoff": {
              "const": "2005-12-31"
            },
            "horizon": {
              "const": "3y"
            },
            "P_prov": {
              "$ref": "#/$defs/predicate"
            },
            "P_obs": {
              "$ref": "#/$defs/predicate"
            },
            "P_cov": {
              "$ref": "#/$defs/predicate"
            },
            "P_anchor": {
              "$ref": "#/$defs/predicate"
            },
            "P_evt": {
              "$ref": "#/$defs/predicate"
            },
            "pair_passes": {
              "type": "boolean",
              "description": "Conjunction of the five predicates (recomputed by the verifier)."
            },
            "aggregates": {
              "$ref": "#/$defs/aggregates"
            },
            "raw_universe_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-fA-F]{64}$",
              "description": "Digest of the custody-held per-event raw universe. The universe itself is never released to the study team (INV-C3)."
            }
          }
        },
