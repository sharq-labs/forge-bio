{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/benchmark-exposure-ledger.v1.schema.json",
  "title": "Forge Bio Benchmark Exposure Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_id",
    "schema_version",
    "benchmark_generation_id",
    "lifecycle_status",
    "exposure_events",
    "attempt_ids",
    "digest"
  ],
  "properties": {
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "benchmark-exposure-ledger-v1"
    },
    "benchmark_generation_id": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_status": {
      "enum": [
        "ACTIVE_CONFIRMATORY",
        "DEVELOPMENT_EXPOSED",
        "EXHAUSTED",
        "RETIRED"
      ]
    },
    "exposure_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exposure_time",
          "exposure_kind",
          "disclosure_level",
          "audience"
        ],
        "properties": {
          "exposure_time": {
            "type": "string",
            "minLength": 1
          },
          "exposure_kind": {
            "enum": [
              "AGGREGATE_METRIC",
              "SUBGROUP_RESULT",
              "PER_CASE_RESULT",
              "LABEL_REVEAL",
              "ADJUDICATION_DISCUSSION",
              "OTHER"
            ]
          },
          "disclosure_level": {
            "enum": [
              "AGGREGATE_ONLY",
              "SUBGROUP",
              "PER_CASE",
              "FULL_LABEL"
            ]
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "downstream_change_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "attempt_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "external_seal_attestation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "digest": {
      "type": "string",
      "minLength": 1
    }
  }
}
