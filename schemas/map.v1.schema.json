{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/map.v1.schema.json",
  "title": "Forge Bio Model Analysis Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "map_id",
    "schema_version",
    "status",
    "created_at",
    "qoi_ref",
    "context_of_use_ref",
    "estimand_ref",
    "benchmark",
    "providers",
    "policies",
    "model",
    "baselines",
    "statistics",
    "outcome_commitment",
    "coverage_gates",
    "planned_analyses",
    "governance",
    "stop_conditions"
  ],
  "properties": {
    "map_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "map-v1"
    },
    "status": {
      "enum": [
        "DRAFT",
        "FROZEN",
        "RETIRED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "frozen_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-fA-F]{8,}$"
    },
    "qoi_ref": {
      "type": "string",
      "minLength": 1
    },
    "context_of_use_ref": {
      "type": "string",
      "minLength": 1
    },
    "estimand_ref": {
      "type": "string",
      "minLength": 1
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_id",
        "generation",
        "cutoff",
        "horizon",
        "disease_sampling_frame_id",
        "candidate_universe_id",
        "development_split_id",
        "validation_split_id",
        "validation_generation_id",
        "sealed_lockbox_id"
      ],
      "properties": {
        "benchmark_id": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        },
        "cutoff": {
          "type": "string",
          "format": "date"
        },
        "horizon": {
          "type": "string",
          "pattern": "^[0-9]+(y| years?)$"
        },
        "disease_sampling_frame_id": {
          "type": "string"
        },
        "candidate_universe_id": {
          "type": "string"
        },
        "development_split_id": {
          "type": "string"
        },
        "validation_split_id": {
          "type": "string"
        },
        "validation_generation_id": {
          "type": "string"
        },
        "sealed_lockbox_id": {
          "type": "string"
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "past_snapshot_ids",
        "future_outcome_source_ids",
        "provider_card_versions",
        "reconstruction_fidelity_verdicts"
      ],
      "properties": {
        "past_snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "future_outcome_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provider_card_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reconstruction_fidelity_verdicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientific_operating_mode",
        "historical_data_policy",
        "temporal_policy_version",
        "identity_policy_version",
        "evidence_schema_version",
        "endpoint_policy_version",
        "endpoint_primary_subtype",
        "outcome_gene_assignment_policy_version",
        "historical_novelty_policy_version",
        "pre_t_genetic_state_policy_version",
        "outcome_phenotype_match_policy_version",
        "genetic_replication_policy_version",
        "genomic_identity_policy_version",
        "variant_harmonization_policy_version",
        "ld_policy_version",
        "historical_genetic_coverage_policy_version",
        "genetic_observability_policy_version",
        "scientific_event_family_policy_version",
        "provider_coupling_policy_version",
        "cross_anchor_event_reuse_policy_version",
        "independence_policy_version",
        "adjudication_policy_version",
        "zero_event_policy_version",
        "multiplicity_policy_version"
      ],
      "properties": {
        "scientific_operating_mode": {
          "enum": [
            "STRICT_HISTORICAL",
            "HISTORICAL_INPUT_MODERN_PRIOR",
            "CURRENT_DISCOVERY"
          ]
        },
        "historical_data_policy": {
          "enum": [
            "ARCHIVED_ONLY",
            "RECONSTRUCTED_ALLOWED"
          ]
        },
        "temporal_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "identity_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "evidence_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "endpoint_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "endpoint_primary_subtype": {
          "type": "string",
          "minLength": 1
        },
        "outcome_gene_assignment_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "historical_novelty_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "pre_t_genetic_state_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "outcome_phenotype_match_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "genetic_replication_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "genomic_identity_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "variant_harmonization_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "ld_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "historical_genetic_coverage_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "genetic_observability_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "scientific_event_family_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "provider_coupling_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "cross_anchor_event_reuse_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "independence_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "adjudication_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "zero_event_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "multiplicity_policy_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm_id",
        "model_version",
        "feature_set_id",
        "config_hash",
        "random_seeds",
        "knowledge_watermark",
        "preprocessing_artifact_ids"
      ],
      "properties": {
        "algorithm_id": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "feature_set_id": {
          "type": "string"
        },
        "config_hash": {
          "type": "string"
        },
        "random_seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "knowledge_watermark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "NON_KNOWLEDGE_BEARING",
                "DATED",
                "UNKNOWN"
              ]
            },
            "date": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "DATED"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "required": [
                  "date"
                ],
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "enum": [
                      "NON_KNOWLEDGE_BEARING",
                      "UNKNOWN"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "properties": {
                  "date": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "preprocessing_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "feature_selection_artifact_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "baselines": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_comparator_id",
        "baseline_ids",
        "discoverability_control_id",
        "combined_nuisance_model_id",
        "nuisance_feature_family_ids"
      ],
      "properties": {
        "primary_comparator_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "discoverability_control_id": {
          "type": "string"
        },
        "combined_nuisance_model_id": {
          "type": "string",
          "minLength": 1
        },
        "nuisance_feature_family_ids": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ATTENTION",
              "ATTENTION_MOMENTUM",
              "GLOBAL_GENE_POPULARITY",
              "ANNOTATION_DENSITY",
              "GENE_LENGTH",
              "VARIANT_OPPORTUNITY",
              "REGIONAL_GENE_DENSITY",
              "LD_ARCHITECTURE",
              "CROSS_TRAIT_PLEIOTROPY",
              "GENETIC_OBSERVABILITY",
              "DISEASE_SAMPLE_SIZE_TRAJECTORY",
              "PROVIDER_COVERAGE"
            ]
          }
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_metric_id",
        "primary_k_or_budget",
        "normalized_companion_metric_id",
        "ci_method",
        "resampling_unit",
        "multiplicity_policy",
        "all_frame_utility_metric_id",
        "dependence_sensitivity_method",
        "null_hypothesis",
        "alternative_hypothesis",
        "test_statistic_id",
        "test_direction",
        "alpha",
        "minimum_scientifically_meaningful_effect",
        "power_target",
        "power_analysis_artifact_id",
        "success_threshold_numeric",
        "confirmatory_generation_budget_id",
        "primary_metric_kind",
        "primary_review_budget"
      ],
      "properties": {
        "primary_metric_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_.:-]{2,127}$"
        },
        "primary_k_or_budget": {
          "type": "string"
        },
        "normalized_companion_metric_id": {
          "type": "string"
        },
        "ci_method": {
          "type": "string"
        },
        "resampling_unit": {
          "type": "string"
        },
        "multiplicity_policy": {
          "type": "string"
        },
        "all_frame_utility_metric_id": {
          "type": "string"
        },
        "dependence_sensitivity_method": {
          "type": "string"
        },
        "null_hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "alternative_hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "test_statistic_id": {
          "type": "string",
          "minLength": 1
        },
        "test_direction": {
          "enum": [
            "ONE_SIDED_GREATER",
            "ONE_SIDED_LESS",
            "TWO_SIDED"
          ]
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.1
        },
        "minimum_scientifically_meaningful_effect": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "power_target": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 0.99
        },
        "power_analysis_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "success_threshold_numeric": {
          "type": "number"
        },
        "confirmatory_generation_budget_id": {
          "type": "string",
          "minLength": 1
        },
        "primary_metric_kind": {
          "enum": [
            "EVENT_RANK_PERCENTILE",
            "RECALL_AT_K",
            "RECALL_AT_PERCENT",
            "NDCG",
            "MRR",
            "OTHER_PREREGISTERED"
          ]
        },
        "primary_review_budget": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "outcome_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "future_outcome_source_release_ids",
        "future_outcome_snapshot_ids",
        "future_outcome_snapshot_digest",
        "outcome_ledger_digest",
        "adjudication_batch_digest",
        "evaluation_identity_bridge_digest",
        "scientific_event_family_ledger_digest",
        "provider_coupling_assessment_digest",
        "outcome_event_discovery_frozen_at"
      ],
      "properties": {
        "future_outcome_source_release_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "future_outcome_snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "future_outcome_snapshot_digest": {
          "type": "string"
        },
        "outcome_ledger_digest": {
          "type": "string"
        },
        "adjudication_batch_digest": {
          "type": "string"
        },
        "evaluation_identity_bridge_digest": {
          "type": "string"
        },
        "scientific_event_family_ledger_digest": {
          "type": "string"
        },
        "provider_coupling_assessment_digest": {
          "type": "string"
        },
        "outcome_event_discovery_frozen_at": {
          "type": "string"
        }
      }
    },
    "coverage_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_temporal_unknown_fraction",
        "min_identity_resolution_fraction",
        "min_outcome_coverage_fraction",
        "max_novelty_ambiguity_fraction",
        "max_assignment_ambiguity_fraction",
        "min_lineage_completeness_fraction",
        "min_historical_genetic_coverage_grade",
        "max_variant_harmonization_ambiguity_fraction"
      ],
      "properties": {
        "max_temporal_unknown_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_identity_resolution_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_outcome_coverage_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_novelty_ambiguity_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_assignment_ambiguity_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_lineage_completeness_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_historical_genetic_coverage_grade": {
          "enum": [
            "HIGH",
            "MODERATE",
            "LOW"
          ]
        },
        "max_variant_harmonization_ambiguity_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "planned_analyses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subgroup_analyses",
        "sensitivity_analyses",
        "source_ablations",
        "negative_controls"
      ],
      "properties": {
        "subgroup_analyses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensitivity_analyses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ablations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "negative_controls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_design_provenance_id",
        "study_tier",
        "ranking_team",
        "outcome_adjudication_role",
        "lockbox_custodian_role",
        "independent_adjudicator_ids",
        "permitted_lockbox_accesses",
        "sealed_disease_blinding_policy",
        "sealed_outcome_adjudicator_blinding_required",
        "validation_generation_status",
        "validation_access_count",
        "validation_max_disclosure_level",
        "deviation_policy",
        "external_seal_attestation_id"
      ],
      "properties": {
        "benchmark_design_provenance_id": {
          "type": "string"
        },
        "ranking_team": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outcome_adjudication_role": {
          "type": "string",
          "minLength": 1
        },
        "lockbox_custodian_role": {
          "type": "string",
          "minLength": 1
        },
        "permitted_lockbox_accesses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "sealed_disease_blinding_policy": {
          "type": "string"
        },
        "sealed_outcome_adjudicator_blinding_required": {
          "type": "boolean"
        },
        "validation_generation_status": {
          "enum": [
            "ACTIVE",
            "SPENT_FOR_MODEL_SELECTION",
            "RETIRED"
          ]
        },
        "validation_access_count": {
          "type": "integer",
          "minimum": 0
        },
        "validation_max_disclosure_level": {
          "enum": [
            "AGGREGATE_ONLY",
            "SUBGROUP",
            "PER_CASE",
            "FULL_LABEL"
          ]
        },
        "deviation_policy": {
          "type": "string"
        },
        "study_tier": {
          "enum": [
            "DEVELOPMENT",
            "CONFIRMATORY",
            "PROSPECTIVE"
          ]
        },
        "independent_adjudicator_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "external_seal_attestation_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "FROZEN"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "frozen_at",
          "digest"
        ],
        "properties": {
          "frozen_at": {
            "type": "string",
            "format": "date-time"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{8,}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "governance": {
            "properties": {
              "study_tier": {
                "enum": [
                  "CONFIRMATORY",
                  "PROSPECTIVE"
                ]
              }
            },
            "required": [
              "study_tier"
            ]
          }
        },
        "required": [
          "governance"
        ]
      },
      "then": {
        "properties": {
          "governance": {
            "properties": {
              "independent_adjudicator_ids": {
                "minItems": 1
              },
              "external_seal_attestation_id": {
                "type": "string",
                "minLength": 1
              },
              "sealed_outcome_adjudicator_blinding_required": {
                "const": true
              },
              "validation_generation_status": {
                "const": "ACTIVE"
              },
              "validation_max_disclosure_level": {
                "const": "AGGREGATE_ONLY"
              }
            }
          },
          "coverage_gates": {
            "properties": {
              "max_temporal_unknown_fraction": {
                "exclusiveMaximum": 1
              },
              "min_outcome_coverage_fraction": {
                "exclusiveMinimum": 0
              },
              "max_novelty_ambiguity_fraction": {
                "exclusiveMaximum": 1
              },
              "max_assignment_ambiguity_fraction": {
                "exclusiveMaximum": 1
              },
              "min_lineage_completeness_fraction": {
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  ]
}
