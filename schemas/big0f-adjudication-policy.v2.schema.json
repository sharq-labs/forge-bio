{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/big0f-adjudication-policy.v2.schema.json",
  "title": "Forge Bio BIG 0F Adjudication Policy v2 (operational definitions + agreement policy)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "schema_version",
    "status",
    "sealed_by_attestation_id",
    "primary_endpoint_subtype",
    "primary_metric_id",
    "primary_study_ascertainment_classes",
    "assignment_classes",
    "phenotype_policy",
    "pre_t_genetic_state",
    "agreement_policy",
    "attention_assignment_association",
    "label_resolution_bias_audit",
    "label_feature_method_coupling_sensitivity_required"
  ],
  "properties": {
    "policy_id": {
      "const": "BIG0F-ADJUDICATION-V2"
    },
    "schema_version": {
      "const": "big0f-adjudication-policy-v2"
    },
    "status": {
      "enum": [
        "SEAL_CANDIDATE",
        "SEALED"
      ]
    },
    "sealed_by_attestation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "primary_endpoint_subtype": {
      "const": "E1-NOVEL-STRICT"
    },
    "primary_metric_id": {
      "const": "EVENT_RANK_PERCENTILE_V1"
    },
    "primary_study_ascertainment_classes": {
      "const": [
        "GENOME_WIDE",
        "EXOME_WIDE",
        "BIOBANK_WIDE"
      ]
    },
    "assignment_classes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "unresolved_locus_class",
        "other_high_specificity_method_allowed"
      ],
      "properties": {
        "primary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "HYPOTHESIS_FREE_CODING_OR_LOF",
            "HIGH_CONFIDENCE_FINE_MAPPING",
            "PREREGISTERED_COLOCALIZATION"
          ],
          "properties": {
            "HYPOTHESIS_FREE_CODING_OR_LOF": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "variant_rule",
                "min_pip",
                "min_r2_with_lead_when_no_fine_mapping",
                "qualifying_consequences",
                "single_gene_required",
                "single_variant_max_p",
                "gene_burden_max_p"
              ],
              "properties": {
                "variant_rule": {
                  "const": "LEAD_OR_PIP_GE_0_5_OR_R2_GE_0_8_WITH_LEAD_IN_DISCOVERY_ANCESTRY"
                },
                "min_pip": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "min_r2_with_lead_when_no_fine_mapping": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "qualifying_consequences": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "single_gene_required": {
                  "const": true
                },
                "single_variant_max_p": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 0.05
                },
                "gene_burden_max_p": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 0.05
                }
              }
            },
            "HIGH_CONFIDENCE_FINE_MAPPING": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "credible_set_level",
                "max_credible_set_size",
                "min_summed_pip_of_gene_linked_variants",
                "variant_to_gene_link",
                "nearest_gene_or_intronic_position_sufficient"
              ],
              "properties": {
                "credible_set_level": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "max_credible_set_size": {
                  "type": "integer",
                  "minimum": 1
                },
                "min_summed_pip_of_gene_linked_variants": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "variant_to_gene_link": {
                  "const": "CODING_OR_SPLICE_CONSEQUENCE_IN_ONE_GENE_OR_QUALIFYING_COLOCALIZATION"
                },
                "nearest_gene_or_intronic_position_sufficient": {
                  "const": false
                }
              }
            },
            "PREREGISTERED_COLOCALIZATION": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "prior_p1",
                "prior_p2",
                "prior_p12",
                "min_pp_h4",
                "cis_window_bp",
                "qtl_resources",
                "unique_gene_at_locus_required",
                "run_by",
                "author_reported_coloc_accepted_only_if_criteria_met"
              ],
              "properties": {
                "method": {
                  "const": "COLOC_ABF"
                },
                "prior_p1": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 0.05
                },
                "prior_p2": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 0.05
                },
                "prior_p12": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 0.05
                },
                "min_pp_h4": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "cis_window_bp": {
                  "type": "integer",
                  "minimum": 1
                },
                "qtl_resources": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "unique_gene_at_locus_required": {
                  "const": true
                },
                "run_by": {
                  "const": "OUTCOME_ADJUDICATION_TEAM"
                },
                "author_reported_coloc_accepted_only_if_criteria_met": {
                  "const": true
                }
              }
            }
          }
        },
        "secondary": {
          "const": [
            "AUTHOR_NAMED",
            "NEAREST_GENE",
            "POSITIONAL_PROXIMITY_ONLY",
            "GENERIC_DATABASE_GENE_FIELD",
            "MODERN_L2G_ONLY",
            "CURRENT_CURATED_TARGET_ONLY",
            "TARGETED_CANDIDATE_GENE_CODING"
          ]
        },
        "unresolved_locus_class": {
          "const": "LOCUS_ONLY"
        },
        "other_high_specificity_method_allowed": {
          "const": false
        }
      }
    },
    "phenotype_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_qualifying_relations",
        "same_concept_different_definition_requires_both_reviewers",
        "non_qualifying_relations",
        "unresolved"
      ],
      "properties": {
        "primary_qualifying_relations": {
          "const": [
            "EXACT",
            "SAME_CONCEPT_DIFFERENT_DEFINITION"
          ]
        },
        "same_concept_different_definition_requires_both_reviewers": {
          "const": true
        },
        "non_qualifying_relations": {
          "const": [
            "NARROWER",
            "BROADER",
            "SURROGATE",
            "RISK_FACTOR",
            "INTERMEDIATE_PHENOTYPE",
            "RELATED"
          ]
        },
        "unresolved": {
          "const": "FAIL_CLOSED"
        }
      }
    },
    "pre_t_genetic_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualifying_max_p",
        "suggestive_max_p",
        "candidate_gene_clause",
        "candidate_gene_clause_sensitivity_required",
        "gene_window_bp",
        "gene_model",
        "event_novelty_distance_bp",
        "event_novelty_min_r2",
        "event_novelty_ld_panel",
        "min_coverage_grade_for_novel_strict",
        "coverage_grade_definitions",
        "coverage_sensitivity"
      ],
      "properties": {
        "qualifying_max_p": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.05
        },
        "suggestive_max_p": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.05
        },
        "candidate_gene_clause": {
          "const": "NOMINAL_P_LE_0_05_IN_AT_LEAST_2_INDEPENDENT_PRE_T_STUDIES_IS_SUGGESTIVE"
        },
        "candidate_gene_clause_sensitivity_required": {
          "const": true
        },
        "gene_window_bp": {
          "type": "integer",
          "minimum": 1
        },
        "gene_model": {
          "const": "AS_OF_T_GENE_MODEL_RELEASE"
        },
        "event_novelty_distance_bp": {
          "type": "integer",
          "minimum": 1
        },
        "event_novelty_min_r2": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "event_novelty_ld_panel": {
          "type": "string",
          "minLength": 1
        },
        "min_coverage_grade_for_novel_strict": {
          "enum": [
            "HIGH",
            "MODERATE"
          ]
        },
        "coverage_grade_definitions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "HIGH",
            "MODERATE",
            "LOW",
            "UNKNOWN"
          ],
          "properties": {
            "HIGH": {
              "type": "string",
              "minLength": 1
            },
            "MODERATE": {
              "type": "string",
              "minLength": 1
            },
            "LOW": {
              "type": "string",
              "minLength": 1
            },
            "UNKNOWN": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "coverage_sensitivity": {
          "const": "HIGH_ONLY_REPORTED"
        }
      }
    },
    "agreement_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statistic",
        "reported_alongside",
        "ci_method",
        "bootstrap_replicates",
        "seed_domain",
        "gated_tasks",
        "reported_tasks",
        "duplicate_review_selection",
        "rule_revision",
        "both_reviewer_labels_stored",
        "same_concept_mandatory_review"
      ],
      "properties": {
        "statistic": {
          "const": "GWET_AC1"
        },
        "reported_alongside": {
          "const": [
            "COHEN_KAPPA",
            "PERCENT_AGREEMENT",
            "CONFUSION_MATRIX"
          ]
        },
        "ci_method": {
          "const": "CASE_BOOTSTRAP_BCA"
        },
        "bootstrap_replicates": {
          "const": 10000
        },
        "seed_domain": {
          "const": "agreement-ci"
        },
        "gated_tasks": {
          "const": {
            "PRIMARY_ASSIGNMENT_ELIGIBILITY": [
              "PRIMARY_ELIGIBLE",
              "NOT_PRIMARY_ELIGIBLE",
              "AMBIGUOUS"
            ],
            "PHENOTYPE_QUALIFICATION": [
              "QUALIFIES",
              "DOES_NOT_QUALIFY",
              "UNRESOLVED"
            ],
            "NOVELTY_ELIGIBILITY": [
              "NOVEL_STRICT_ELIGIBLE",
              "NOT_ELIGIBLE",
              "AMBIGUOUS"
            ],
            "PRIMARY_POSITIVE_STATUS": [
              "PRIMARY_POSITIVE",
              "NOT_PRIMARY_POSITIVE",
              "AMBIGUOUS"
            ]
          }
        },
        "reported_tasks": {
          "const": [
            "ASSIGNMENT_CLASS_FULL",
            "PRE_T_GENETIC_STATE",
            "EVENT_FAMILY_IDENTITY",
            "SAMPLE_OVERLAP"
          ]
        },
        "duplicate_review_selection": {
          "const": {
            "method": "SALTED_KEYED_HASH_ORDER_STRATIFIED",
            "key_domain": "dup-review",
            "salt": "S_REV_COMMITTED_IN_S6_USED_PRIVATELY_AFTER_FIRST_REVIEW_LABEL_SET_REGISTERED_PUBLISHED_AFTER_SECOND_REVIEW_LABELS",
            "strata": [
              "DISEASE"
            ],
            "allocation": "PROPORTIONAL_MIN_ONE_PER_NONEMPTY_STRATUM",
            "size_rule": "MIN_N_MAX_30_CEIL_0_30_N",
            "applies_to": [
              "EVENT_CASES",
              "NON_EVENT_CASES"
            ]
          }
        },
        "rule_revision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_revisions",
            "retest_set",
            "min_retest_cases",
            "gates_evaluated_on",
            "insufficient_cases",
            "pre_revision_agreement_reported",
            "allowed_scope",
            "retest_salt"
          ],
          "properties": {
            "max_revisions": {
              "const": 1
            },
            "retest_set": {
              "const": "SALTED_ORDER_S_RET_OVER_ALL_CASES_STRATIFIED_BY_DISEASE_SAME_SIZE_RULE"
            },
            "min_retest_cases": {
              "type": "integer",
              "minimum": 30
            },
            "gates_evaluated_on": {
              "const": "RETEST_SET_WHEN_REVISED"
            },
            "pre_revision_agreement_reported": {
              "const": true
            },
            "allowed_scope": {
              "const": "CLARIFICATION_THAT_CHANGES_NO_VALUE_IN_THIS_POLICY_APPLIED_TO_ALL_CASES_ELSE_PROTOCOL_AMENDMENT"
            },
            "retest_salt": {
              "const": "S_RET_COMMITTED_IN_S6_USED_PRIVATELY_AFTER_POST_REVISION_LABEL_SET_REGISTERED_PUBLISHED_AFTER_RETEST_LABELS"
            },
            "insufficient_cases": {
              "const": "INCONCLUSIVE"
            }
          }
        },
        "both_reviewer_labels_stored": {
          "const": true
        },
        "same_concept_mandatory_review": {
          "const": "UNDRAWN_SAME_CONCEPT_CASES_MIXED_INTO_SECOND_REVIEWER_BATCH_EXCLUDED_FROM_AC1_AND_COVERAGE"
        }
      }
    },
    "attention_assignment_association": {
      "const": {
        "statistic": "SPEARMAN_RHO",
        "attention_variable": "PRE_T_DISEASE_SPECIFIC_ATTENTION_PERCENTILE_OF_ASSIGNED_GENE",
        "outcome_variable": "ATTENTION_SENSITIVE_ASSIGNMENT_INDICATOR",
        "attention_sensitive_classes": [
          "AUTHOR_NAMED",
          "NEAREST_GENE"
        ],
        "population": "ALL_ADJUDICATED_POST_T_EVENT_FAMILIES_IN_PILOT",
        "matched_comparison_sample": "NONE",
        "ci_method": "FISHER_Z_95_TWO_SIDED"
      }
    },
    "label_resolution_bias_audit": {
      "const": {
        "statistic": "SPEARMAN_RHO",
        "attention_variable": "PRE_T_DISEASE_SPECIFIC_ATTENTION_PERCENTILE_OF_NEAREST_GENE",
        "outcome_variable": "PRIMARY_RESOLVABLE_INDICATOR",
        "population": "ALL_POST_T_EVENT_FAMILIES_IN_PILOT",
        "ci_method": "FISHER_Z_95_TWO_SIDED"
      }
    },
    "label_feature_method_coupling_sensitivity_required": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SEALED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "sealed_by_attestation_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "sealed_by_attestation_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
