{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/big0f-curation-audit.v1.schema.json",
  "title": "Forge Bio BIG 0F Curation Audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_id",
    "schema_version",
    "operational_capacity_rule_id",
    "event_case_records",
    "non_event_case_records",
    "digest"
  ],
  "properties": {
    "audit_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "big0f-curation-audit-v1"},
    "operational_capacity_rule_id": {"type": "string", "minLength": 1},
    "event_case_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "minutes", "provenance_digest"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "minutes": {"type": "number", "minimum": 0},
          "provenance_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
        }
      }
    },
    "non_event_case_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "minutes", "provenance_digest"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "minutes": {"type": "number", "minimum": 0},
          "provenance_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
        }
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
  }
}
