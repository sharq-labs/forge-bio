{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/external-seal-attestation.v1.schema.json",
  "title": "Forge Bio External Seal Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_id",
    "schema_version",
    "artifact_digest",
    "artifact_type",
    "sealed_at",
    "external_registry_or_custodian_ref",
    "attestation_method",
    "signer_or_service_identity",
    "verification_status",
    "provenance_ref",
    "digest",
    "authority_type",
    "independence_from_study_team",
    "verification_evidence_ref",
    "verified_at",
    "independence_evidence_ref"
  ],
  "properties": {
    "attestation_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "external-seal-attestation-v1"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "artifact_type": {
      "enum": [
        "BIG0F_PROTOCOL_REGISTRATION",
        "BIG0F_SELECTION_REGISTRATION",
        "BIG0F_SEAL_BUNDLE",
        "RESEARCH_PROGRAM_LEDGER_STATE",
        "CONFIRMATORY_SEAL_BUNDLE",
        "MAP",
        "RANKING_ARTIFACT",
        "OTHER"
      ]
    },
    "sealed_at": {
      "type": "string",
      "format": "date-time",
      "description": "The time asserted by the external authority itself: the Bitcoin block time of the earliest attesting block for THIRD_PARTY_TIMESTAMP, or the public registration time for PUBLIC_REGISTRY. Never a study-team clock. seal_time of an artifact = max over its paired attestations (INV-S3)."
    },
    "external_registry_or_custodian_ref": {
      "type": "string",
      "minLength": 1
    },
    "attestation_method": {
      "enum": [
        "SIGNED_CUSTODIAN_ATTESTATION",
        "THIRD_PARTY_TIMESTAMP",
        "PUBLIC_PREREGISTRATION"
      ]
    },
    "signer_or_service_identity": {
      "type": "string",
      "minLength": 1
    },
    "verification_status": {
      "enum": [
        "VERIFIED",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "provenance_ref": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "authority_type": {
      "enum": [
        "INDEPENDENT_CUSTODIAN",
        "THIRD_PARTY_TIMESTAMP_SERVICE",
        "PUBLIC_REGISTRY"
      ]
    },
    "independence_from_study_team": {
      "const": true
    },
    "verification_evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "independence_evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "paired_attestation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "The complementary attestation (PUBLIC_REGISTRY <-> THIRD_PARTY_TIMESTAMP) over the same artifact_digest."
    },
    "bitcoin_block_height": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "registry_record_public": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "true only if the registry record is publicly retrievable without embargo at verification time (INV-S4)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "authority_type": {
            "const": "INDEPENDENT_CUSTODIAN"
          }
        },
        "required": [
          "authority_type"
        ]
      },
      "then": {
        "properties": {
          "attestation_method": {
            "const": "SIGNED_CUSTODIAN_ATTESTATION"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority_type": {
            "const": "THIRD_PARTY_TIMESTAMP_SERVICE"
          }
        },
        "required": [
          "authority_type"
        ]
      },
      "then": {
        "properties": {
          "attestation_method": {
            "const": "THIRD_PARTY_TIMESTAMP"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority_type": {
            "const": "PUBLIC_REGISTRY"
          }
        },
        "required": [
          "authority_type"
        ]
      },
      "then": {
        "properties": {
          "attestation_method": {
            "const": "PUBLIC_PREREGISTRATION"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "properties": {
          "independence_from_study_team": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "enum": [
              "BIG0F_PROTOCOL_REGISTRATION",
              "BIG0F_SELECTION_REGISTRATION",
              "BIG0F_SEAL_BUNDLE",
              "RESEARCH_PROGRAM_LEDGER_STATE",
              "CONFIRMATORY_SEAL_BUNDLE"
            ]
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "authority_type": {
            "enum": [
              "THIRD_PARTY_TIMESTAMP_SERVICE",
              "PUBLIC_REGISTRY"
            ]
          },
          "verification_status": {
            "const": "VERIFIED"
          },
          "paired_attestation_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "paired_attestation_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "authority_type": {
            "const": "THIRD_PARTY_TIMESTAMP_SERVICE"
          }
        },
        "required": [
          "authority_type"
        ]
      },
      "then": {
        "required": [
          "bitcoin_block_height"
        ],
        "properties": {
          "bitcoin_block_height": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority_type": {
            "const": "PUBLIC_REGISTRY"
          }
        },
        "required": [
          "authority_type"
        ]
      },
      "then": {
        "required": [
          "registry_record_public"
        ],
        "properties": {
          "registry_record_public": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "enum": [
              "BIG0F_PROTOCOL_REGISTRATION",
              "BIG0F_SELECTION_REGISTRATION",
              "BIG0F_SEAL_BUNDLE",
              "RESEARCH_PROGRAM_LEDGER_STATE",
              "CONFIRMATORY_SEAL_BUNDLE"
            ]
          },
          "authority_type": {
            "const": "PUBLIC_REGISTRY"
          }
        },
        "required": [
          "artifact_type",
          "authority_type"
        ]
      },
      "then": {
        "properties": {
          "registry_record_public": {
            "const": true
          }
        }
      }
    }
  ]
}
