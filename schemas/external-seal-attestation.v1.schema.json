{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/external-seal-attestation.v1.schema.json",
  "title": "Forge Bio External Seal Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_id",
    "schema_version",
    "artifact_digest",
    "artifact_type",
    "sealed_at",
    "external_registry_or_custodian_ref",
    "attestation_method",
    "signer_or_service_identity",
    "verification_status",
    "provenance_ref",
    "digest",
    "authority_type",
    "independence_from_study_team",
    "verification_evidence_ref"
  ],
  "properties": {
    "attestation_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "external-seal-attestation-v1"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{8,}$"
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1
    },
    "sealed_at": {
      "type": "string",
      "format": "date-time"
    },
    "external_registry_or_custodian_ref": {
      "type": "string",
      "minLength": 1
    },
    "attestation_method": {
      "enum": [
        "SIGNED_CUSTODIAN_ATTESTATION",
        "THIRD_PARTY_TIMESTAMP",
        "PUBLIC_PREREGISTRATION"
      ]
    },
    "signer_or_service_identity": {
      "type": "string",
      "minLength": 1
    },
    "verification_status": {
      "enum": [
        "VERIFIED",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "provenance_ref": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "minLength": 1
    },
    "authority_type": {
      "enum": [
        "INDEPENDENT_CUSTODIAN",
        "THIRD_PARTY_TIMESTAMP_SERVICE",
        "PUBLIC_REGISTRY"
      ]
    },
    "independence_from_study_team": {
      "const": true
    },
    "verification_evidence_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "properties": {
          "independence_from_study_team": {
            "const": true
          }
        }
      }
    }
  ]
}
