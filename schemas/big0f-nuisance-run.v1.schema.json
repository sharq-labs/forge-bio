{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-bio.local/schemas/big0f-nuisance-run.v1.schema.json",
  "title": "Forge Bio BIG 0F Nuisance Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "schema_version",
    "nuisance_manifest_digest",
    "pilot_model_evaluation_mode",
    "actual_feature_families",
    "feature_artifact_digests",
    "semantic_evidence_features_used",
    "learner_family_id",
    "preprocessing_digest",
    "training_config_digest",
    "model_artifact_digest",
    "event_rank_records",
    "digest",
    "candidate_universe_digest",
    "full_rank_output_digest",
    "source_release_ids",
    "feature_transform_digest",
    "hyperparameter_search_space_digest",
    "tuning_budget_id",
    "early_stopping_rule_id",
    "random_seed_policy_id",
    "feature_family_records"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "big0f-nuisance-run-v1"
    },
    "nuisance_manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "pilot_model_evaluation_mode": {
      "const": "NUISANCE_ONLY"
    },
    "actual_feature_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "feature_artifact_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-fA-F]{64}$"
      }
    },
    "semantic_evidence_features_used": {
      "const": false
    },
    "learner_family_id": {
      "type": "string",
      "minLength": 1
    },
    "preprocessing_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "training_config_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "model_artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "event_rank_records": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "disease_id",
          "rank_fraction",
          "rank_position",
          "candidate_universe_size"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "disease_id": {
            "type": "string",
            "minLength": 1
          },
          "rank_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rank_position": {
            "type": "integer",
            "minimum": 1
          },
          "candidate_universe_size": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "candidate_universe_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "full_rank_output_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "source_release_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "feature_transform_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "hyperparameter_search_space_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "tuning_budget_id": {
      "type": "string",
      "minLength": 1
    },
    "early_stopping_rule_id": {
      "type": "string",
      "minLength": 1
    },
    "random_seed_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "feature_family_records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_family_id",
          "source_release_ids",
          "feature_artifact_digest",
          "transform_digest"
        ],
        "properties": {
          "feature_family_id": {
            "type": "string",
            "minLength": 1
          },
          "source_release_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "feature_artifact_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          },
          "transform_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          }
        }
      }
    }
  }
}
